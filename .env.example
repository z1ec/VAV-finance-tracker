# Copy to .env and fill in. In production .env lives only on the server (/opt/finance-tracker/.env).
#
# On a real DOMAIN the backend refuses to start if SECRET_KEY is empty/default/shorter than
# 32 chars or a configured user's password is a default (admin/user1/user2) or shorter than 12.
# Generate: openssl rand -hex 32  /  openssl rand -base64 18
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
USER1_USERNAME=
USER1_PASSWORD=
USER2_USERNAME=
USER2_PASSWORD=
DB_PATH=/data/expenses.db
TZ=Europe/Budapest
# localhost -> plain HTTP for local development (http://localhost:8080 with docker-compose.yml).
# A real domain -> Caddy gets a Let's Encrypt certificate and serves HTTPS on 443;
# https://<domain>:8443 permanently redirects to https://<domain>.
DOMAIN=localhost
