# Copy to .env and fill in. In production .env lives only on the server (/opt/finance-tracker/.env).
#
# On a real DOMAIN the backend refuses to start if SECRET_KEY is empty/default/shorter than
# 32 chars or a configured user's password is a default (admin/user1/user2) or shorter than 12.
# Generate: openssl rand -hex 32  /  openssl rand -base64 18
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
USER1_USERNAME=
USER1_PASSWORD=
USER2_USERNAME=
USER2_PASSWORD=
DB_PATH=/data/expenses.db
TZ=Europe/Budapest
# localhost -> plain HTTP for local development (http://localhost:8080 with docker-compose.yml).
# A real domain -> Caddy gets a Let's Encrypt certificate and serves HTTPS on 443;
# https://<domain>:8443 permanently redirects to https://<domain>.
DOMAIN=localhost

# --- Bot API (stage 2a, docs/API_BOT.md) -------------------------------------------------
# The Momentum bot calls the API with "Authorization: Bearer <token>" from the Docker network
# vav-internal only. Only the token's SHA-256 (hex) is stored here; the token itself lives in
# the bot's .env (FINANCE_API_TOKEN). Empty hash = token disabled. How to (re)issue a token:
# docs/MANUAL_STEPS.ru.md.
BOT_API_TOKEN_SHA256=
# Existing admin user the bot's operations are recorded for.
BOT_API_USERNAME=
# CSV of private CIDR networks the token is accepted from (the vav-internal subnet,
# `docker network inspect vav-internal`). Empty = the token is accepted from nowhere.
BOT_API_ALLOWED_NETWORKS=
